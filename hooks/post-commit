#!/usr/bin/env bash
# 提交後的 Jira 連動提示 — 適用於任何 agent 或純終端機 git。
# 本身不呼叫 Jira，只把該做的事印到 stderr，由驅動的 agent 執行。
set -uo pipefail

subject=$(git log -1 --pretty=%s 2>/dev/null) || exit 0
body=$(git log -1 --pretty=%B 2>/dev/null) || exit 0
sha=$(git rev-parse --short HEAD 2>/dev/null) || exit 0

keys=$(printf '%s' "$body" | grep -oE '\b[A-Z][A-Z0-9]+-[0-9]+\b' | awk '!seen[$0]++' | paste -sd', ' -)

if [ -z "$keys" ]; then
  cat >&2 <<MSG

[Jira] commit ${sha}「${subject}」沒有引用任何票號。
GitLab 整合因此不會掛上連結，這筆紀錄不會被追蹤。
若非有意為之，可用 git commit --amend 補上票號。

MSG
  exit 0
fi

cat >&2 <<MSG

[Jira] commit ${sha}「${subject}」引用了 ${keys}
請依各票的 Jira site／project metadata 與 workflow 逐項處理：

  1. 讀取每張票狀態。若目前是未開始狀態，讀取該 project 的可用
     transitions，依實際名稱與 ID 轉為「進行中」，不可猜測 ID。
  1b. 若該票是子任務，一併檢查父任務：只要任一子任務是進行中
     或完成，而父任務仍是未開始狀態，父任務也要依 metadata 轉為進行中。
  1c. 若流程要求 Sprint／Backlog，確認該票是否已加入目標 board 與 Sprint，
     未加入時依使用者指定的 board／Sprint 操作並回讀驗證。
  2. 若本次內容已完成某張票或其子任務，**先詢問使用者**；
     得到同意才使用該 project metadata 回傳的完成 transition。未經同意不要轉成完成。
  2b. 若某張父任務底下的子任務**全部**都是「完成」，提示使用者
     該父任務是否可以結案。一樣要經使用者同意才使用完成 transition，
     不可因為子任務都完成就自行結案。
  3. 若需回填類別，先讀取該 project 的欄位 metadata 與可用選項，
     不可沿用其他 project 的 customfield ID 或選項 ID。
  4. 驗證 commit／MR 是否已出現在每張票的 Web links。未自動掛上時，
     使用 Jira Remote Link 寫入可用 URL；不要用留言代替。

MSG
exit 0
